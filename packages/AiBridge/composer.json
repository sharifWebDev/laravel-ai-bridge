{
    "name": "sharifuddin/laravel-ai-bridge",
    "description": "A professional, robust, and modular AI-driven integration for Laravel, enabling LLMs to dynamically execute application controller methods as tools.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sharif Uddin",
            "email": "sharif.webpro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sharifuddin\\LaravelAiBridge\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sharifuddin\\LaravelAiBridge\\AiBridgeServiceProvider"
            ]
        }
    }
}
